# Copy to .env.local only for `vercel dev` if you test the API locally.
# Production: set these in Vercel → Project → Settings → Environment Variables.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Multi-tenant API scoping (must match seed UUID in supabase/migrations/009_multi_tenancy.sql)
# DEFAULT_TENANT_ID=a3d8e7f1-2b4c-4a21-9e5f-6c0d1e2f3a4b

# Jobber → Supabase one-off migration (scripts/jobber-migrate.mjs; developer.getjobber.com app)
# JOBBER_CLIENT_ID=
# JOBBER_CLIENT_SECRET=
# Optional: skip OAuth if you already have a token for the target Jobber account
# JOBBER_ACCESS_TOKEN=
# Migration script tuning (Jobber GraphQL cost / throttling)
# JOBBER_GRAPHQL_PAGE_SIZE=12
# JOBBER_PAGINATION_DELAY_MS=6000
# JOBBER_THROTTLE_RETRY_MAX=12
# Vercel Cron: /api/cron/jobber-sync (see vercel.json). First run: set JOBBER_REFRESH_TOKEN from OAuth token response; then encrypted copy is stored on tenants (needs QUICKBOOKS_TOKEN_ENCRYPTION_KEY).
# CRON_SECRET=   # required for cron auth if set
# JOBBER_REFRESH_TOKEN=

# Public pay page (/pay/:token)
# VITE_ETRANSFER_EMAIL=payments@example.com
# Optional: full URL to your logo on the invoice header (else built-in mark is used)
# VITE_INVOICE_LOGO_URL=https://example.com/logo.png
# GST / HST registration number shown under tax on the public invoice
# VITE_GST_REGISTRATION=123456789RT0001

# QuickBooks Online (per-tenant OAuth: /api/quickbooks-connect, /api/quickbooks-callback)
# Create an app at https://developer.intuit.com — redirect URI must match exactly.
# QUICKBOOKS_CLIENT_ID=
# QUICKBOOKS_CLIENT_SECRET=
# QUICKBOOKS_REDIRECT_URI=https://YOUR_DEPLOYMENT_HOST/api/quickbooks-callback
# QUICKBOOKS_TOKEN_ENCRYPTION_KEY=   # 64 hex chars: openssl rand -hex 32
# QUICKBOOKS_APP_ORIGIN=https://YOUR_DEPLOYMENT_HOST   # optional; else derived from REDIRECT_URI
# QUICKBOOKS_STATE_SECRET=   # optional; random string for OAuth state signing
