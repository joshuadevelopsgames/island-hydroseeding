# Copy to .env.local only for `vercel dev` if you test the API locally.
# Production: set these in Vercel → Project → Settings → Environment Variables.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Public pay page (/pay/:token)
# VITE_ETRANSFER_EMAIL=payments@example.com
# Optional: full URL to your logo on the invoice header (else built-in mark is used)
# VITE_INVOICE_LOGO_URL=https://example.com/logo.png
# GST / HST registration number shown under tax on the public invoice
# VITE_GST_REGISTRATION=123456789RT0001
